# Copy to .env and adjust. Never commit the real .env (PRD B.5).

# --- General ---------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# --- Database --------------------------------------------------------------
# Matches the postgres service in ../docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://officeiq:officeiq@localhost:5433/officeiq

# --- Auth ------------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
INVITE_TOKEN_EXPIRE_HOURS=72
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Email -----------------------------------------------------------------
# file = write to ./outbox | console = log only | smtp = real delivery
EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=./outbox
EMAIL_FROM=no-reply@officeiq.dev
EMAIL_FROM_NAME=OfficeIQ

# Only needed when EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- Document storage (Phase 2) --------------------------------------------
# local = filesystem (no services needed) | s3 = S3-compatible (MinIO / AWS S3)
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=./storage
# Matches the minio service in ../docker-compose.yml
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=officeiq-documents
S3_ACCESS_KEY=officeiq
S3_SECRET_KEY=officeiq123
S3_REGION=us-east-1

MAX_UPLOAD_SIZE_MB=10
DOWNLOAD_URL_EXPIRE_SECONDS=300

# --- OCR / extraction (Phase 2) --------------------------------------------
# tesseract = self-hosted (requires the tesseract binary) | stub = no-op for CI
OCR_ENGINE=tesseract
# Leave blank to find `tesseract` on PATH
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
OCR_LANGUAGES=eng
OCR_PDF_DPI=200
# Fields scoring below this are flagged for manual HR review
OCR_LOW_CONFIDENCE_THRESHOLD=0.70
# Run extraction inline rather than in a background task (tests use this)
OCR_PROCESS_SYNCHRONOUSLY=false

# --- Face matching (Phase 3) -----------------------------------------------
# opencv_dnn = YuNet + SFace ONNX models | stub = no-op for CI
# Fetch the models first: python scripts/download_face_models.py
FACE_MATCHER=opencv_dnn
FACE_MODEL_DIR=./models
# Cosine similarity above which two faces are treated as the same person
FACE_MATCH_THRESHOLD=0.363
# YuNet score above which a detection counts as a face. Kept at 0.60 because a
# photo inside a full ID-card scan scores ~0.80-0.85 even when perfectly clear.
FACE_DETECTION_CONFIDENCE=0.60

# --- Mock ID verification (Phase 3) -----------------------------------------
# Simulated UIDAI/NSDL. No government API is contacted in v1 (PRD A.4.2).
MOCK_VERIFICATION_PROVIDER=mock-uidai-nsdl
NAME_MATCH_THRESHOLD=0.80
VERIFICATION_PROCESS_SYNCHRONOUSLY=false

# --- RAG chatbot: generation (Phase 5) --------------------------------------
# claude = Anthropic Messages API | stub = deterministic canned answer for CI
CHAT_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...   (or run `ant auth login` — the SDK finds it)
CHAT_MODEL=claude-opus-5
CHAT_MAX_TOKENS=2000
# Adaptive-thinking depth: low | medium | high | xhigh | max
CHAT_EFFORT=medium

# --- RAG chatbot: embeddings (Phase 5) --------------------------------------
# NOTE: the Claude API has NO embeddings endpoint. Voyage AI is Anthropic's
# recommended embeddings partner. `local` is a deterministic hashing embedder
# that needs no key — used by the test suite; retrieval quality is poor.
EMBEDDING_PROVIDER=voyage
# VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3
# Must match the model's output width AND the pgvector column. Changing this
# requires a migration and re-embedding every chunk.
EMBEDDING_DIMENSIONS=1024

# --- Chunking & retrieval ---------------------------------------------------
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=5
# Chunks below this cosine similarity are discarded as irrelevant
RETRIEVAL_MIN_SIMILARITY=0.35
# Below this answer confidence the assistant escalates to HR
CHAT_ESCALATION_THRESHOLD=0.45
INGEST_PROCESS_SYNCHRONOUSLY=false

# --- Notifications & dashboard (Phase 6) ------------------------------------
# In-app notifications are always written. This additionally emails employee-facing
# events through EMAIL_BACKEND above. Off by default so a dev outbox stays readable.
NOTIFICATION_EMAIL_ENABLED=false
# A task this many days from its due date counts as "due soon"
TASK_DUE_SOON_DAYS=3
# Default window for /dashboard/summary and /dashboard/trends
DASHBOARD_TREND_DAYS=30
# An in-flight onboarding untouched for this long is flagged as stalled
ONBOARDING_STALLED_DAYS=7

# --- Hardening (Phase 8) ----------------------------------------------------
# Host header allow-list. "*" is fine behind a proxy that already pins the host.
ALLOWED_HOSTS=*
HSTS_MAX_AGE_SECONDS=31536000
GZIP_MIN_SIZE_BYTES=1024
# Requests slower than this are logged at WARNING with their route.
SLOW_REQUEST_MS=1000
REQUEST_ID_HEADER=X-Request-ID

# Rate limits. The default backend is per-process and in-memory: exact with one
# worker, approximate with several. See "Rate limiting" in the README.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASSWORD_RESET=5/hour
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_REPORTS=30/hour

# --- Connection pool & query logging ----------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
# Log statements slower than this many ms. 0 disables.
SLOW_QUERY_MS=0

# --- Frontend --------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Bootstrap admin (used by `python -m app.seed`) ------------------------
FIRST_ADMIN_EMAIL=admin@officeiq.dev
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=System Administrator
